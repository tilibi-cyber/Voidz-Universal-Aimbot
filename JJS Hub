-- ====================== CLEANUP OLD ======================
local function fullCleanup()
    local old = playerGui:FindFirstChild("DarkForgeNaoyaUI")
    if old then old:Destroy() end
    local oldESP = playerGui:FindFirstChild("DarkForgeESPOverlay")
    if oldESP then oldESP:Destroy() end
    for _, oldEffect in ipairs(Lighting:GetDescendants()) do
        if oldEffect.Name == "DarkForgeNightVisionColor" then oldEffect:Destroy() end
    end
    local oldBlindness = Lighting:FindFirstChild("DarkForgeBlindnessGrade")
    if oldBlindness then oldBlindness:Destroy() end
    local oldBlindFolder = workspace:FindFirstChild("DarkForgeBlindnessHighlights")
    if oldBlindFolder then oldBlindFolder:Destroy() end
    local oldThermalFolder = workspace:FindFirstChild("DarkForgeThermalVision")
    if oldThermalFolder then oldThermalFolder:Destroy() end
    local oldThermalGrade = Lighting:FindFirstChild("DarkForgeThermalGrade")
    if oldThermalGrade then oldThermalGrade:Destroy() end
    local oldThermalBloom = Lighting:FindFirstChild("DarkForgeThermalBloom")
    if oldThermalBloom then oldThermalBloom:Destroy() end
    local oldAnimeGrade = Lighting:FindFirstChild("DarkForgeAnimeGrade")
    if oldAnimeGrade then oldAnimeGrade:Destroy() end
    local oldWorldGrade = Lighting:FindFirstChild("DarkForgeAnimeWorldGrade")
    if oldWorldGrade then oldWorldGrade:Destroy() end
    local oldWorldBloom = Lighting:FindFirstChild("DarkForgeAnimeWorldBloom")
    if oldWorldBloom then oldWorldBloom:Destroy() end
    -- Restore only nearby parts from a previous Anime World session. The old effect
    -- only stylized parts within 260 studs, so a bounded spatial query is sufficient.
    local oldRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if oldRoot then
        local restoreParams = OverlapParams.new()
        restoreParams.FilterType = Enum.RaycastFilterType.Exclude
        restoreParams.FilterDescendantsInstances = {player.Character}
        restoreParams.MaxParts = 450
        for _, part in ipairs(workspace:GetPartBoundsInRadius(oldRoot.Position, 265, restoreParams)) do
            local originalColor = part:GetAttribute("DarkForgeAnimeOriginalColor")
            local originalMaterial = part:GetAttribute("DarkForgeAnimeOriginalMaterial")
            local originalReflectance = part:GetAttribute("DarkForgeAnimeOriginalReflectance")
            if originalColor then part.Color = originalColor end
            if originalMaterial and Enum.Material[originalMaterial] then part.Material = Enum.Material[originalMaterial] end
            if originalReflectance ~= nil then part.Reflectance = originalReflectance end
            if originalColor or originalMaterial or originalReflectance ~= nil then
                part:SetAttribute("DarkForgeAnimeOriginalColor", nil)
                part:SetAttribute("DarkForgeAnimeOriginalMaterial", nil)
                part:SetAttribute("DarkForgeAnimeOriginalReflectance", nil)
            end
        end
    end
    local oldWorldInk = workspace:FindFirstChild("DarkForge_AnimeWorldInk")
    if oldWorldInk then oldWorldInk:Destroy() end
    local oldRoaring = workspace:FindFirstChild("DarkForge_RoaringAfterimages")
    if oldRoaring then oldRoaring:Destroy() end
    local oldFlightStreaks = workspace:FindFirstChild("DarkForge_WorldFlightStreaks")
    if oldFlightStreaks then oldFlightStreaks:Destroy() end
    local character = player.Character
    if character then
        local descendants = character:GetDescendants()
        for _, obj in ipairs(descendants) do
            if obj:IsA("ObjectValue") and obj.Value then
                pcall(function() obj.Value:Destroy() end)
            end
        end
        for _, obj in ipairs(descendants) do
            if obj.Parent and (obj.Name == "DarkForge_FlightFX" or obj.Name == "DarkForge_rain" or obj.Name == "DarkForge_anime" or obj.Name == "DarkForge_rage" or obj.Name == "DarkForge_roaring" or obj.Name == "DarkForge_menace" or obj.Name == "DarkForgeRainLoop") then
                obj:Destroy()
            end
        end
    end
    for _, obj in ipairs(playerGui:GetChildren()) do
        if obj.Name:match("^MenacingBillboard") then obj:Destroy() end
    end
end
fullCleanup()
