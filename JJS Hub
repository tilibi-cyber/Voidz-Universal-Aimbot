setFlashstep = function(enabled)
    if enabled == flashstepEnabled then return end
    local character = player.Character
    local camera = workspace.CurrentCamera
    if enabled then
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local root = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root then return end
        local oldArchivable = character.Archivable
        character.Archivable = true
        local clone = character:Clone()
        character.Archivable = oldArchivable
        if not clone then return end
        clone.Name = "DarkForge_FlashstepReplica"
        for _, obj in ipairs(clone:GetDescendants()) do
            if obj.Name:match("^DarkForge_") or obj:IsA("Script") or obj:IsA("LocalScript") then
                obj:Destroy()
            elseif obj:IsA("BasePart") then
                obj.CanCollide = false
                obj.CanTouch = false
                obj.CanQuery = false
                obj.Massless = true
            end
        end
        local cloneHum = clone:FindFirstChildOfClass("Humanoid")
        local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
        if not cloneHum or not cloneRoot then clone:Destroy(); return end
        clone.Parent = workspace
        clone:PivotTo(root.CFrame)
        cloneHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        cloneHum.PlatformStand = true
        cloneRoot.Anchored = true
        flashstepOrigin = root.Position
        flashstepOriginal = {
            character=character, humanoid=humanoid, root=root,
            anchored=root.Anchored, platformStand=humanoid.PlatformStand,
            autoRotate=humanoid.AutoRotate, walkSpeed=humanoid.WalkSpeed,
            jumpPower=humanoid.JumpPower, jumpHeight=humanoid.JumpHeight,
            useJumpPower=humanoid.UseJumpPower
        }
        flashstepCameraSubject = camera and camera.CameraSubject
        root.Anchored = true
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.JumpHeight = 0
        humanoid.AutoRotate = false
        humanoid.PlatformStand = true
        flashstepClone = clone
        flashstepEnabled = true
        if camera then camera.CameraSubject = cloneHum end
    else
        flashstepEnabled = false
        local original = flashstepOriginal
        local clone = flashstepClone
        local cloneRoot = clone and clone:FindFirstChild("HumanoidRootPart")
        if original and original.root and original.root.Parent then
            if cloneRoot then
                local destination = cloneRoot.Position
                local delta = destination - flashstepOrigin
                if delta.Magnitude > flashstepRange then
                    destination = flashstepOrigin + delta.Unit * flashstepRange
                end
                original.root.CFrame = CFrame.new(destination) * cloneRoot.CFrame.Rotation
            end
            original.root.Anchored = original.anchored
            if original.humanoid and original.humanoid.Parent then
                original.humanoid.PlatformStand = original.platformStand
                original.humanoid.AutoRotate = original.autoRotate
                original.humanoid.WalkSpeed = original.walkSpeed
                original.humanoid.JumpPower = original.jumpPower
                original.humanoid.JumpHeight = original.jumpHeight
                original.humanoid.UseJumpPower = original.useJumpPower
            end
        end
        if camera then
            local originalHum = original and original.humanoid
            camera.CameraSubject = (originalHum and originalHum.Parent and originalHum) or flashstepCameraSubject
        end
        if clone then clone:Destroy() end
        flashstepClone = nil
        flashstepOrigin = nil
        flashstepOriginal = nil
        flashstepCameraSubject = nil
    end
end

local function updateFlashstep(dt)
    if not flashstepEnabled or not flashstepClone then return end
    local root = flashstepClone:FindFirstChild("HumanoidRootPart")
    if not root then setFlashstep(false); return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local forward = Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)
    local right = Vector3.new(camera.CFrame.RightVector.X,0,camera.CFrame.RightVector.Z)
    if forward.Magnitude > 0 then forward = forward.Unit end
    if right.Magnitude > 0 then right = right.Unit end
    local move = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then move += forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then move -= forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then move += right end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then move -= right end
    local vertical = 0
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical += 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then vertical -= 1 end
    local gamepadOk, gamepadState = pcall(function() return UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) end)
    if gamepadOk then
        for _, input in ipairs(gamepadState) do
            if input.KeyCode == Enum.KeyCode.Thumbstick1 then
                move += right * input.Position.X + forward * input.Position.Y
            end
        end
    end
    local buttonsOk, ascendDown = pcall(function()
        return UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA)
    end)
    if buttonsOk and ascendDown then vertical = 1 end
    local descendOk, descendDown = pcall(function()
        return UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonB)
    end)
    if descendOk and descendDown then vertical = -1 end
    local direction = move + Vector3.new(0,vertical,0)
    if direction.Magnitude > 1 then direction = direction.Unit end
    local nextPosition = root.Position + direction * flashstepMoveSpeed * math.min(dt,0.05)
    local displacement = nextPosition - flashstepOrigin
    if displacement.Magnitude > flashstepRange then
        nextPosition = flashstepOrigin + displacement.Unit * flashstepRange
    end
    local face = Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)
    if face.Magnitude < 0.001 then face = root.CFrame.LookVector end
    root.CFrame = CFrame.lookAt(nextPosition, nextPosition + face.Unit)
end

