    flightTracks.forward = loadAnim(FLIGHT_FORWARD_ANIM, true)
    flightTracks.back    = loadAnim(FLIGHT_BACK_ANIM, true)
    if flightTracks.toggle then
        flightTracks.toggle:Play(0.1)
    end
    local start = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local a = 1 - math.clamp((tick() - start) / 1, 0, 1)
        if a <= 0 or not flightEnabled then
            conn:Disconnect()
            return
        end
        if flightBV then
            flightBV.Velocity = Vector3.new(0, 14 * a, 0)
