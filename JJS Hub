            -- Remove any Nightvision-only door highlight, even if the tracking table was stale.
            if not doorESP then
                for target, h in pairs(doorHighlights) do
                    if h then h:Destroy() end
                    doorHighlights[target] = nil
                end
            end
            -- Remove any orphaned Nightvision highlights left by an interrupted toggle.
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Highlight") and (obj.Name == "DarkForgeNightVisionHighlight" or obj.Name == "DarkForgeNightVisionDoorHighlight") then
                    obj:Destroy()
                end
            end
            if nightVisionPrevious then
                highlightESP=nightVisionPrevious.highlightESP; tracersESP=nightVisionPrevious.tracersESP
                boxESP=nightVisionPrevious.boxESP
