local function playerListContains(list, targetPlayer)
    if typeof(targetPlayer) ~= "Instance" or not targetPlayer:IsA("Player") then return false end
    local username = string.lower(targetPlayer.Name)
    local display = string.lower(targetPlayer.DisplayName)
    return list[username] == true or list[display] == true
end
local function isBlacklisted(targetPlayer)
    return playerListContains(blacklistPlayers, targetPlayer)
end
local function getNPCModelFromPart(part, excludedCharacter)
    local model = part and part:FindFirstAncestorOfClass("Model")
    while model and model ~= excludedCharacter do
        local hum = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildWhichIsA("Humanoid", true)
        if hum then return model, hum end
        model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model") or nil
    end
    return nil, nil
end

local function getNPCRoot(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart", true)
        or model.PrimaryPart
        or model:FindFirstChild("UpperTorso", true)
        or model:FindFirstChild("Torso", true)
        or model:FindFirstChild("LowerTorso", true)
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function getESPColor(targetPlayer)
    if typeof(targetPlayer) == "Instance" and targetPlayer:IsA("Model") then
        return Color3.fromRGB(70, 255, 110)
    end
    if playerListContains(whitelistPlayers, targetPlayer) then return whitelistColor end
    if isBlacklisted(targetPlayer) then return blacklistColor end
    return whitelistColor
end
local function setPlayerListEntry(list, name, enabled)
    local key = string.lower((name or ""):match("^%s*(.-)%s*$") or "")
    if key == "" then return false end
    if enabled then list[key] = true else list[key] = nil end
    return true
end

