            nightVisionPrevious = {highlightESP=highlightESP, tracersESP=tracersESP, boxESP=boxESP, statESP=statESP}
            highlightESP, tracersESP, boxESP, statESP = false, false, false, false
            for _, h in pairs(playerHighlights) do if h then h:Destroy() end end
            table.clear(playerHighlights)
            clearDrawings(tracerLines); clearDrawings(boxLines)
            nightVisionTint.Visible=true; nightVisionHud.Visible=true
            local staticLayer=espGui:FindFirstChild("NVStaticLayer"); if staticLayer then staticLayer.Visible=true end
            local cornerLayer=espGui:FindFirstChild("NVScreenCorners"); if cornerLayer then cornerLayer.Visible=true end
            local effect=Lighting:FindFirstChild("DarkForgeNightVisionColor") or Instance.new("ColorCorrectionEffect")
            effect.Name="DarkForgeNightVisionColor"; effect.TintColor=Color3.fromRGB(185,255,195)
            effect.Saturation=-.18; effect.Contrast=.12; effect.Brightness=.025; effect.Parent=Lighting
        else
            if nightVisionTint then nightVisionTint.Visible=false end
            if nightVisionHud then nightVisionHud.Visible=false end
            local staticLayer=espGui and espGui:FindFirstChild("NVStaticLayer"); if staticLayer then staticLayer.Visible=false end
            local cornerLayer=espGui and espGui:FindFirstChild("NVScreenCorners"); if cornerLayer then cornerLayer.Visible=false end
            -- Remove every duplicate NV color grade, including leftovers from older runs.
            for _, effect in ipairs(Lighting:GetDescendants()) do
                if effect.Name == "DarkForgeNightVisionColor" then effect:Destroy() end
            end
            -- Door highlights are also tinted green by Nightvision; remove them if Door ESP is off,
            -- otherwise immediately restore the user's normal Door ESP palette.
            for target, h in pairs(doorHighlights) do
                if not doorESP then
                    if h then h:Destroy() end
                    doorHighlights[target] = nil
                elseif h and h.Parent then
                    h.Name = "DarkForgeDoorESPHighlight"
                    h.FillColor = doorColor
                    h.OutlineColor = Color3.new(0, 0, 0)
                    h.FillTransparency = doorFillTrans
                    h.OutlineTransparency = doorOutlineTrans
                end
