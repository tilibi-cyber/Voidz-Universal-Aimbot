    addConn(RunService.RenderStepped:Connect(function()
        if not blindnessEnabled or not blindnessWorldFolder then return end
        local now = os.clock()
        if now - blindnessLastScan < 0.25 then return end
        blindnessLastScan = now
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        if not blindnessLocalHighlight or not blindnessLocalHighlight.Parent or blindnessLocalHighlight.Adornee ~= character then
            if blindnessLocalHighlight then blindnessLocalHighlight:Destroy() end
            blindnessLocalHighlight = Instance.new("Highlight")
            blindnessLocalHighlight.Name = "BlindnessLocalPlayerWhite"
            blindnessLocalHighlight.Adornee = character
            blindnessLocalHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            blindnessLocalHighlight.FillColor = Color3.new(1, 1, 1)
            blindnessLocalHighlight.OutlineColor = Color3.new(1, 1, 1)
            blindnessLocalHighlight.FillTransparency = 0
            blindnessLocalHighlight.OutlineTransparency = 0
            blindnessLocalHighlight.Parent = character
        end

        -- Sample a dense grid across the actual camera view. This places many small
        -- non-collidable light points on the visible face of nearby blocks instead
        -- of scattering a few dots in every direction around the character.
        blindnessRayParams.FilterDescendantsInstances = {character, blindnessWorldFolder}
        local markerIndex = 0
        local camera = workspace.CurrentCamera
        local columns, rows = 24, 18
        if camera then
            local viewport = camera.ViewportSize
            for row = 1, rows do
                for column = 1, columns do
                    local px = (column - 0.5) / columns * viewport.X
                    local py = (row - 0.5) / rows * viewport.Y
                    local viewRay = camera:ViewportPointToRay(px, py)
                    local result = workspace:Raycast(viewRay.Origin, viewRay.Direction * blindnessRange, blindnessRayParams)
                    if result and result.Instance and result.Instance:IsA("BasePart") then
                        local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
                        if not (hitModel and hitModel:FindFirstChildOfClass("Humanoid")) then
                            markerIndex += 1
                            local marker = blindnessSurfaceMarkers[markerIndex]
                            if marker then
                                local distance = (result.Position - root.Position).Magnitude
                                local brightness = math.clamp(1 - (distance / blindnessRange) * 0.62, 0.28, 1)
                                local size = 0.85 + brightness * 0.65
                                marker.Color = Color3.new(brightness, brightness, brightness)
                                marker.Size = Vector3.new(size, size, size)
                                marker.CFrame = CFrame.new(result.Position + result.Normal * 0.045)
                                marker.Transparency = 0.015
                            end
                        end
                    end
                end
            end
        end
        local rayCount = #blindnessSurfaceMarkers
        for i = markerIndex + 1, rayCount do
            local marker = blindnessSurfaceMarkers[i]
            if marker then marker.Transparency = 1 end
        end

        local overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        overlap.FilterDescendantsInstances = {character, blindnessWorldFolder}
        overlap.MaxParts = 0
        local seenModels = {}
        for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, blindnessRange, overlap)) do
            local model = part:FindFirstAncestorOfClass("Model")
            if model and model ~= character then
                local hum = model:FindFirstChildOfClass("Humanoid")
                local modelRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
                if hum and hum.Health > 0 and modelRoot and (modelRoot.Position-root.Position).Magnitude <= blindnessRange then
                    local targetPlayer = Players:GetPlayerFromCharacter(model)
                    local show, fill, outline
                    if targetPlayer then
                        show = modelRoot.AssemblyLinearVelocity.Magnitude > 0.65
                        fill, outline = Color3.fromRGB(35, 115, 255), Color3.fromRGB(135, 195, 255)
                    else
                        show = true
                        fill, outline = Color3.fromRGB(30, 220, 85), Color3.fromRGB(150, 255, 175)
                    end
                    if show then
                        seenModels[model] = true
                        local h = blindnessPlayerHighlights[model]
                        if not h or not h.Parent then
                            h = Instance.new("Highlight")
                            h.Name = targetPlayer and "BlindnessMovingPlayerHighlight" or "BlindnessNPCGreenHighlight"
                            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            h.Parent = blindnessWorldFolder
                            blindnessPlayerHighlights[model] = h
                        end
                        h.Adornee = model
                        h.FillColor = fill
                        h.OutlineColor = outline
                        h.FillTransparency = targetPlayer and 0.18 or 0.12
                        h.OutlineTransparency = 0
                    end
                end
            end
        end
        for model, h in pairs(blindnessPlayerHighlights) do
            if not seenModels[model] or not model.Parent then
                h:Destroy()
                blindnessPlayerHighlights[model] = nil
            end
        end
    end))

    addConn(RunService.Heartbeat:Connect(function(dt)
        if not thermalVisionESP or not thermalFolder then return end
        local now = os.clock()
        if now - thermalLastScan < 0.5 then return end
        thermalLastScan = now
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        overlap.FilterDescendantsInstances = {char, thermalFolder}
        overlap.MaxParts = 80
        local seen, seenModels = {}, {}
        for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, 320, overlap)) do
            if part:IsA("BasePart") and part.Transparency < 0.95 then
                local model = part:FindFirstAncestorOfClass("Model")
                local hum = model and model:FindFirstChildOfClass("Humanoid")
                local targetPlayer = hum and Players:GetPlayerFromCharacter(model)
                if not hum then
                    local h = thermalHighlights[part]
                    if not h or not h.Parent then
                        h = Instance.new("Highlight")
                        h.Name = "ThermalBlueEnvironment"
                        h.Adornee = part
                        h.DepthMode = Enum.HighlightDepthMode.Occluded
                        h.Parent = thermalFolder
                        thermalHighlights[part] = h
                    end
                    h.FillColor = Color3.fromRGB(18, 78, 210)
                    h.OutlineColor = Color3.fromRGB(65, 180, 255)
                    h.FillTransparency = 0.42
                    h.OutlineTransparency = 0.12
                    seen[part] = true
                elseif model ~= char and not seenModels[model] then
                    seenModels[model] = true
                    local modelRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
                    local speedHeat = math.clamp((modelRoot and modelRoot.AssemblyLinearVelocity.Magnitude or 0) / 22, 0, 1)
                    for _, bodyPart in ipairs(model:GetDescendants()) do
                        if bodyPart:IsA("BasePart") and bodyPart.Name ~= "HumanoidRootPart" then
                            local h = thermalHighlights[bodyPart]
                            if not h or not h.Parent then
                                h = Instance.new("Highlight")
                                h.Name = targetPlayer and "ThermalPlayerHeatCell" or "ThermalNPCHeatCell"
                                h.Adornee = bodyPart
                                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                h.Parent = thermalFolder
                                thermalHighlights[bodyPart] = h
                            end
                            if targetPlayer then
                                -- Per-part heat variation gives a thermal-camera ramp instead
                                -- of one flat orange fill across the entire character.
                                local partName = bodyPart.Name:lower()
                                local localHeat = 0.52 + speedHeat * 0.28
                                if partName:find("head") then
                                    localHeat += 0.18
                                elseif partName:find("torso") then
                                    localHeat += 0.10
                                elseif partName:find("hand") or partName:find("foot") then
                                    localHeat -= 0.16
                                end
                                localHeat = math.clamp(localHeat, 0, 1)
                                local cold = Color3.fromRGB(28, 60, 210)
                                local cyan = Color3.fromRGB(0, 225, 255)
                                local orange = Color3.fromRGB(255, 105, 20)
                                local white = Color3.fromRGB(255, 250, 220)
                                local heatColor
                                if localHeat < 0.45 then
                                    heatColor = cold:Lerp(cyan, localHeat / 0.45)
                                elseif localHeat < 0.82 then
                                    heatColor = cyan:Lerp(orange, (localHeat - 0.45) / 0.37)
                                else
                                    heatColor = orange:Lerp(white, (localHeat - 0.82) / 0.18)
                                end
                                h.FillColor = heatColor
                                h.OutlineColor = heatColor:Lerp(Color3.new(1,1,1), 0.55)
                                h.FillTransparency = 0.10
                            else
                                h.FillColor = Color3.fromRGB(35, 220, 90)
                                h.OutlineColor = Color3.fromRGB(175, 255, 185)
                                h.FillTransparency = 0.12
                            end
                            h.OutlineTransparency = 0
                            seen[bodyPart] = true
                        end
                    end
                end
            end
        end
        for key, h in pairs(thermalHighlights) do
            if not seen[key] or not key.Parent then
                h:Destroy()
                thermalHighlights[key] = nil
            end
        end
    end))
    addConn(RunService.Heartbeat:Connect(function(dt)
        if flashstepEnabled then updateFlashstep(dt) end
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and hum.FloorMaterial ~= Enum.Material.Air then
            geppoCurrent = 0
        end
        if speedEnabled and hum then
            hum.WalkSpeed = tonumber(speedBox.Text) or 16
        end
        if tpWalkEnabled and hum and root and hum.MoveDirection.Magnitude > 0.05 then
            root.CFrame = root.CFrame + hum.MoveDirection * tpWalkPower
        end
        -- Player Highlight ESP is updated by the throttled ESP renderer above.
        -- Door ESP
        if doorESP or nightVisionESP then
            if tick() - lastDoorScan > 1.0 then
                lastDoorScan = tick()
                local doorParams = OverlapParams.new()
                doorParams.FilterType = Enum.RaycastFilterType.Exclude
                doorParams.FilterDescendantsInstances = {char}
                doorParams.MaxParts = 500
                local doorParts = root and workspace:GetPartBoundsInRadius(root.Position, 350, doorParams) or {}
                local seenDoors = {}
                for _, obj in ipairs(doorParts) do
                    local ancestorModel = obj:FindFirstAncestorOfClass("Model")
                    local doorNamed = obj.Name:lower():find("door") or obj.Name:lower():find("halloween")
                    local modelNamed = ancestorModel and (ancestorModel.Name:lower():find("door") or ancestorModel.Name:lower():find("halloween"))
                    if obj:IsA("BasePart") and (doorNamed or modelNamed) then
                        local doorTarget = ancestorModel or obj
                        seenDoors[doorTarget] = true
                        if not doorHighlights[doorTarget] then
                            local h = Instance.new("Highlight")
                            h.Name = nightVisionESP and "DarkForgeNightVisionDoorHighlight" or "DarkForgeDoorESPHighlight"
                            h.Adornee = doorTarget
                            h.Parent = doorTarget
                            doorHighlights[doorTarget] = h
                        end
                        local h = doorHighlights[doorTarget]
                        h.Name = nightVisionESP and "DarkForgeNightVisionDoorHighlight" or "DarkForgeDoorESPHighlight"
                        h.FillColor = nightVisionESP and Color3.fromRGB(85, 255, 135) or doorColor
                        h.OutlineColor = nightVisionESP and Color3.fromRGB(190, 255, 205) or Color3.new(0, 0, 0)
                        h.FillTransparency = nightVisionESP and 0.28 or doorFillTrans
                        h.OutlineTransparency = nightVisionESP and 0 or doorOutlineTrans
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    end
                end
                for doorTarget, h in pairs(doorHighlights) do
                    if not seenDoors[doorTarget] or not doorTarget.Parent then
                        h:Destroy()
                        doorHighlights[doorTarget] = nil
                    end
                end
            end
        end
        -- FLIGHT
        if flightEnabled and flightBV and root then
            local cam = workspace.CurrentCamera
            local dir = Vector3.zero
            local forward = false
            local back = false
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector forward = true end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector back = true end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
            pcall(function()
                local state = UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
                if state then
                    for _, inp in ipairs(state) do
                        if inp.KeyCode == Enum.KeyCode.Thumbstick1 then
                            local s = inp.Position
                            if s.Magnitude > 0.15 then
                                dir += cam.CFrame.LookVector * s.Y
                                dir += cam.CFrame.RightVector * s.X
                                if s.Y > 0.2 then forward = true end
                                if s.Y < -0.2 then back = true end
                            end
                        end
                    end
                end
            end)
            if dir.Magnitude < 0.1 then
                sprinting = false
                flightBV.Velocity = Vector3.zero
                playFlightAnim("idle")
                targetFOV = originalFOV
            else
                if forward then
                    targetFlightSpeed = flightBoost and 175 or 90
                    targetFOV = originalFOV + (flightBoost and 42 or 20)
                    playFlightAnim("forward")
                elseif back then
                    targetFlightSpeed = flightBoost and 75 or 35
                    targetFOV = originalFOV
                    playFlightAnim("back")
                else
                    targetFlightSpeed = 45
                    targetFOV = originalFOV
                end
                flightSpeed = flightSpeed + (targetFlightSpeed - flightSpeed) * 0.16
                flightBV.Velocity = dir.Unit * flightSpeed
            end
            updateFlightSpeedLines(forward and dir.Magnitude >= 0.1, dt)
            cam.FieldOfView = cam.FieldOfView + (targetFOV - cam.FieldOfView) * 0.1
            -- Camera pitch is authoritative. BodyGyro continuously forces the
            -- complete 3D facing direction instead of lerping against Humanoid joints.
            if not (naoyaMode and holdingActivate) and flightBG and flightBG.Parent then
                local look = cam.CFrame.LookVector
                if look.Magnitude > 0.001 then
                    flightBG.CFrame = CFrame.lookAt(root.Position, root.Position + look.Unit, cam.CFrame.UpVector)
                end
            end
        end
        -- Naoya
        if naoyaMode and holdingActivate and root then
            local closest, dist = nil, 999
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (p.Character.HumanoidRootPart.Position - root.Position).Magnitude
                    if d < dist then dist = d closest = p.Character.HumanoidRootPart end
                end
            end
            if closest then
                local off = naoyaModeType == "infront" and closest.CFrame.LookVector * 3.5
                    or naoyaModeType == "behind" and -closest.CFrame.LookVector * 3.5
                    or naoyaModeType == "above" and Vector3.new(0, 6, 0)
                    or Vector3.new(math.random(-5, 5), 0, math.random(-5, 5))
                root.CFrame = CFrame.new(closest.Position + off, closest.Position)
            end
        end
    end))
    print("[Ω V0IDZ HUB Ω] v" .. VERSION .. " loaded")
end
