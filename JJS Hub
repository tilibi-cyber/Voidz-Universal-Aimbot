local function createFlightStreaks()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if #flightSpeedLines > 0 then
        local alive = false
        for _, data in ipairs(flightSpeedLines) do
            if data.part and data.part.Parent then alive = true break end
        end
        if alive then return end
    end
    flightSpeedLines = {}
    if flightSpeedLineFolder then flightSpeedLineFolder:Destroy() end
    flightSpeedLineFolder = Instance.new("Folder")
    flightSpeedLineFolder.Name = "DarkForge_WorldFlightStreaks"
    flightSpeedLineFolder.Parent = workspace

    -- Long, clean world-space trails arranged around the player, moving from
    -- the forward field of view past the camera. These are not screen GUI lines.
    for i = 1, 24 do
        local part = Instance.new("Part")
        part.Name = "FlightStreakAnchor"
        part.Size = Vector3.new(0.08, 0.08, 0.08)
        part.Transparency = 1
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = false
        part.Parent = flightSpeedLineFolder
        local a0 = Instance.new("Attachment")
        a0.Position = Vector3.new(0, 0, 0)
        a0.Parent = part
        local a1 = Instance.new("Attachment")
        local length = math.random(45, 100) / 10
        a1.Position = Vector3.new(0, 0, -length)
        a1.Parent = part
        local trail = Instance.new("Trail")
        trail.Name = "FlightSpeedTrail"
        trail.Attachment0 = a0
        trail.Attachment1 = a1
        trail.FaceCamera = true
        trail.LightEmission = 0.9
        trail.LightInfluence = 0
        trail.Lifetime = 0.16
        trail.MinLength = 0.08
        trail.WidthScale = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.075), NumberSequenceKeypoint.new(0.2, 0.045), NumberSequenceKeypoint.new(1, 0)})
        trail.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.08), NumberSequenceKeypoint.new(1, 1)})
        trail.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)), ColorSequenceKeypoint.new(0.35, Color3.fromRGB(165,230,255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(65,135,255))})
        trail.Enabled = false
        trail.Parent = part
        table.insert(flightSpeedLines, {
            part=part, trail=trail,
            offset=Vector2.new(math.random(-180,180)/10, math.random(-110,110)/10),
            phase=math.random(), rate=math.random(75,125)/100,
            depth=math.random(20,48), length=length
        })
    end
end

