    }, card)
    TweenService:Create(card, TweenInfo.new(.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position=UDim2.new(0,18,0,92)
    }):Play()
    task.delay(5.5, function()
        if card and card.Parent then
            local tween=TweenService:Create(card,TweenInfo.new(.35,Enum.EasingStyle.Quint,Enum.EasingDirection.In),{
                Position=UDim2.new(0,-330,0,92)
            })
            tween:Play(); tween.Completed:Wait()
            if card.Parent then card:Destroy() end
            if flightNotice==card then flightNotice=nil end
        end
    end)
end

local function updateFlightSpeedLines(isForward, dt)
    local show = flightEnabled and isForward
    if not show then
        for _, data in ipairs(flightSpeedLines) do
            if data.trail then data.trail.Enabled = false end
        end
        return
    end
    createFlightStreaks()
    local camera = workspace.CurrentCamera
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not camera or not root then return end
    dt = math.min(dt or 1/60, 1/20)
    local look, right, up = camera.CFrame.LookVector, camera.CFrame.RightVector, camera.CFrame.UpVector
    local multiplier = flightBoost and 1.9 or 1
    local travel = flightBoost and 125 or 92
    for _, data in ipairs(flightSpeedLines) do
        data.phase = (data.phase + dt * data.rate * multiplier) % 1
        local depth = data.depth - data.phase * travel
        local pos = root.Position + look * depth + right * data.offset.X + up * data.offset.Y
        data.part.CFrame = CFrame.lookAt(pos, pos + look)
        data.trail.Enabled = true
        data.trail.Lifetime = flightBoost and 0.22 or 0.16
    end
end

local function clearPlayerEffect(name)
    local conn = playerEffectConnections[name]
    if conn then conn:Disconnect(); playerEffectConnections[name] = nil end
    local folder = playerEffectFolders[name]
    if folder then
        for _, descendant in ipairs(folder:GetDescendants()) do
            if descendant:IsA("ObjectValue") and descendant.Value then
                descendant.Value:Destroy()
            end
        end
        folder:Destroy()
        playerEffectFolders[name] = nil
    end
    if name == "anime" then
        for part, original in pairs(animeOriginals) do
            if part and part.Parent then
                part.Color = original.color
                part.Material = original.material
                part.Reflectance = original.reflectance
            end
        end
        animeOriginals = {}
    elseif name == "rain" then
        rainParts = {}
        if rainSound then rainSound:Stop(); rainSound:Destroy(); rainSound = nil end
    end
end

local function makeEffectFolder(name, character)
    local folder = Instance.new("Folder")
    folder.Name = "DarkForge_" .. name
    folder.Parent = character
    playerEffectFolders[name] = folder
    return folder
end

local function applyPlayerEffect(name)
    clearPlayerEffect(name)
    if not playerEffectStates[name] then return end
    local character = player.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    if not root then return end
    local folder = makeEffectFolder(name, character)

    if name == "rain" then
        -- Dense, straight-down rain with a much higher fall velocity.
        for i = 1, 110 do
            local streak = Instance.new("Part")
            streak.Name = "RainStreak"
            streak.Anchored = true
            streak.CanCollide = false
            streak.CanTouch = false
            streak.CanQuery = false
            streak.CastShadow = false
            streak.Material = Enum.Material.Neon
            streak.Color = (i % 5 == 0) and Color3.fromRGB(225,245,255) or Color3.fromRGB(100,165,255)
            streak.Transparency = math.random(8, 26) / 100
            streak.Size = Vector3.new(0.025, math.random(95,175) / 100, 0.025)
            streak.Parent = folder
            table.insert(rainParts, {
                part=streak,
                offset=Vector3.new(math.random(-180,180)/10, math.random(0,180)/10, math.random(-180,180)/10),
                fallSpeed=math.random(125,205)
            })
        end
        rainSound = Instance.new("Sound")
        rainSound.Name = "DarkForgeRainLoop"
        rainSound.SoundId = "rbxassetid://1274987416"
        rainSound.Looped = true
        rainSound.Volume = 0.65
        rainSound.Parent = root
        rainSound:Play()
        local rainAttachment = Instance.new("Attachment")
        rainAttachment.Name = "RainMistAttachment"
        rainAttachment.Position = Vector3.new(0, -1.1, 0)
        rainAttachment.Parent = root
        local rainRef = Instance.new("ObjectValue")
        rainRef.Name = "RainMistCleanupRef"
        rainRef.Value = rainAttachment
        rainRef.Parent = folder
        local mist = Instance.new("ParticleEmitter")
        mist.Name = "RainAtmosphereMist"
        mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
        mist.Rate = 18
        mist.Lifetime = NumberRange.new(0.45, 0.85)
        mist.Speed = NumberRange.new(1.2, 3.4)
        mist.SpreadAngle = Vector2.new(180, 180)
        mist.Color = ColorSequence.new(Color3.fromRGB(125,185,255))
        mist.LightEmission = 0.2
        mist.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,0.65), NumberSequenceKeypoint.new(1,1.7)})
        mist.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0.78), NumberSequenceKeypoint.new(1,1)})
        mist.Parent = rainAttachment
        playerEffectConnections.rain = RunService.Heartbeat:Connect(function(dt)
            if not playerEffectStates.rain or not root.Parent then return end
            for _, data in ipairs(rainParts) do
                local part = data.part
                if part and part.Parent then
                    data.offset -= Vector3.new(0, data.fallSpeed * dt, 0)
                    if data.offset.Y < -10 then
                        data.offset = Vector3.new(math.random(-180,180)/10, math.random(95,180)/10, math.random(-180,180)/10)
                    end
                    part.CFrame = CFrame.new(root.Position + data.offset) -- perfectly vertical; no tilt
                end
            end
        end)

    elseif name == "anime" then
        -- Character-only illustrated cel treatment. Roblox LocalScripts cannot
        -- install a custom GPU shader, so this uses stepped colors + ink contours.
        local function posterize(color)
            local luminance = color.R * 0.2126 + color.G * 0.7152 + color.B * 0.0722
            local band = luminance < 0.22 and 0.48 or (luminance < 0.48 and 0.72 or (luminance < 0.76 and 0.94 or 1.12))
            return Color3.new(
                math.clamp(math.floor(color.R * band * 4 + 0.5) / 4, 0, 1),
                math.clamp(math.floor(color.G * band * 4 + 0.5) / 4, 0, 1),
                math.clamp(math.floor(color.B * band * 4 + 0.5) / 4, 0, 1)
            )
        end
        local characterInk = Instance.new("Highlight")
        characterInk.Name = "AnimeCharacterInkSilhouette"
        characterInk.Adornee = character
        characterInk.DepthMode = Enum.HighlightDepthMode.Occluded
        characterInk.FillTransparency = 1
        characterInk.OutlineColor = Color3.fromRGB(12, 10, 16)
        characterInk.OutlineTransparency = 0
        characterInk.Parent = folder
        for _, descendant in ipairs(character:GetDescendants()) do
            if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
                local original = descendant.Color
                animeOriginals[descendant] = {color=original, material=descendant.Material, reflectance=descendant.Reflectance}
                descendant.Material = Enum.Material.SmoothPlastic
                descendant.Reflectance = 0
                local celColor = posterize(original)
                descendant.Color = celColor
                local ink = Instance.new("Highlight")
                ink.Name = "AnimeCelShade"
                ink.Adornee = descendant
                ink.DepthMode = Enum.HighlightDepthMode.Occluded
                ink.FillColor = celColor:Lerp(Color3.fromRGB(12, 10, 16), 0.22)
                ink.FillTransparency = 0.38
                ink.OutlineColor = Color3.fromRGB(12, 10, 16)
                ink.OutlineTransparency = 0
                ink.Parent = folder
            end
        end
    elseif name == "rage" then
        if not head then folder:Destroy(); playerEffectFolders[name]=nil; return end
        local rageLights = {}
        local rageOutline = Instance.new("Highlight")
        rageOutline.Name = "RageAuraOutline"
        rageOutline.Adornee = character
        rageOutline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        rageOutline.FillColor = Color3.fromRGB(115,0,8)
        rageOutline.FillTransparency = 0.88
        rageOutline.OutlineColor = Color3.fromRGB(255,25,35)
        rageOutline.OutlineTransparency = 0.04
        rageOutline.Parent = folder
        local rageAttachment = Instance.new("Attachment")
        rageAttachment.Name = "RageEmberAttachment"
        rageAttachment.Parent = root
        local rageRef = Instance.new("ObjectValue")
        rageRef.Name = "RageEmberCleanupRef"
        rageRef.Value = rageAttachment
        rageRef.Parent = folder
        local embers = Instance.new("ParticleEmitter")
        embers.Name = "RageEmbers"
        embers.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        embers.Rate = 24
        embers.Lifetime = NumberRange.new(0.18,0.48)
        embers.Speed = NumberRange.new(1.5,5)
        embers.SpreadAngle = Vector2.new(180,180)
        embers.Color = ColorSequence.new(Color3.fromRGB(255,245,230), Color3.fromRGB(255,0,12))
        embers.LightEmission = 1
        embers.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,0.16), NumberSequenceKeypoint.new(0.35,0.09), NumberSequenceKeypoint.new(1,0)})
        embers.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0.05), NumberSequenceKeypoint.new(1,1)})
        embers.Parent = rageAttachment
        -- Sharp manga-style eye flares: a bright four-point star with a red
        -- outer glow. No plates, bars, or solid shapes cover the eyes.
        local flareBeams = {}
        local flareLights = {}
        local function makeRay(origin, endpoint, rayName, isRing)
            local a0 = Instance.new("Attachment")
            a0.Name = "RageFlareA0"
            a0.Position = origin
            a0.Parent = head
            local a1 = Instance.new("Attachment")
            a1.Name = "RageFlareA1"
            a1.Position = endpoint
            a1.Parent = head
            for _, attachment in ipairs({a0, a1}) do
                local ref = Instance.new("ObjectValue")
                ref.Name = "RageFlareAttachmentCleanup"
                ref.Value = attachment
                ref.Parent = folder
            end
            local glow = Instance.new("Beam")
            glow.Name = rayName .. "RedGlow"
            glow.Attachment0 = a0
            glow.Attachment1 = a1
            glow.FaceCamera = true
            glow.LightEmission = 1
            glow.ZOffset = 2
            glow.Color = ColorSequence.new(Color3.fromRGB(255, 10, 22))
            glow.Transparency = NumberSequence.new(isRing and 0.48 or 0.12)
            glow.Width0 = isRing and 0.014 or 0.075
            glow.Width1 = 0.001
            glow.Parent = folder
            local core = Instance.new("Beam")
            core.Name = rayName .. "WhiteCore"
            core.Attachment0 = a0
            core.Attachment1 = a1
            core.FaceCamera = true
            core.LightEmission = 1
            core.ZOffset = 2.1
            core.Color = ColorSequence.new(Color3.fromRGB(255, 252, 245))
            core.Transparency = NumberSequence.new(isRing and 0.12 or 0)
            core.Width0 = isRing and 0.006 or 0.024
            core.Width1 = 0.0005
            core.Parent = folder
            table.insert(flareBeams, {glow=glow, core=core, base=isRing and 0.014 or 0.045})
        end
        for side = -1, 1, 2 do
            -- Put the flare just in front of the face surface; the long horizontal
            -- streak is the visible eye-line, with shorter diagonal glints around it.
            local center = Vector3.new(side * 0.145, 0.105, -(head.Size.Z * 0.5 + 0.16))
            local rays = {
                Vector3.new(side * 0.52, 0.005, 0),
                Vector3.new(-side * 0.20, 0, 0),
                Vector3.new(0, -0.16, 0),
                Vector3.new(0, 0.16, 0),
                Vector3.new(side * 0.13, 0.11, 0),
                Vector3.new(-side * 0.13, -0.11, 0)
            }
            for index, offset in ipairs(rays) do
                makeRay(center, center + offset, "RageEyeFlare" .. side .. "_" .. index, false)
            end
            local light = Instance.new("PointLight")
            light.Name = "RageEyeFlareLight"
            light.Color = Color3.fromRGB(255, 30, 38)
            light.Brightness = 1.1
            light.Range = 4
            light.Parent = head
            local lightRef = Instance.new("ObjectValue")
            lightRef.Name = "RageEyeFlareLightCleanup"
            lightRef.Value = light
            lightRef.Parent = folder
            table.insert(flareLights, light)
        end
        playerEffectConnections.rage = RunService.RenderStepped:Connect(function()
            local pulse = 0.72 + math.abs(math.sin(os.clock() * 8)) * 0.28
            for _, data in ipairs(flareBeams) do
                if data.glow and data.glow.Parent then
                    data.glow.Width0 = data.base * (0.82 + pulse * 0.35)
                end
                if data.core and data.core.Parent then
                    data.core.Width0 = data.base * (data.base < 0.02 and 0.42 or 0.34) * (0.9 + pulse * 0.2)
                end
            end
            for _, light in ipairs(flareLights) do
                if light and light.Parent then light.Brightness = 1.1 + pulse * 1.6 end
            end
        end)

    elseif name == "roaring" then
        -- Flowing ribbon of silhouettes peeling off the player and drifting backward.
        local afterFolder = Instance.new("Folder")
        afterFolder.Name = "DarkForge_RoaringAfterimages"
        afterFolder.Parent = workspace
        local folderRef = Instance.new("ObjectValue")
        folderRef.Name = "RoaringAfterimageFolderRef"
        folderRef.Value = afterFolder
        folderRef.Parent = folder
        local elapsed, lastPosition = 0, root.Position
        local activeGhosts = {}
        local MAX_GHOSTS, GHOST_INTERVAL, GHOST_LIFETIME = 7, 0.075, 0.52

        local function spawnAfterimage(direction)
            if not character.Parent or #activeGhosts >= MAX_GHOSTS then return end
            local wasArchivable = character.Archivable
            character.Archivable = true
            local ok, ghost = pcall(function() return character:Clone() end)
            character.Archivable = wasArchivable
            if not ok or not ghost then return end
            ghost.Name = "DarkForge_RoaringSilhouette"
            for _, obj in ipairs(ghost:GetDescendants()) do
                if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("Humanoid") or obj:IsA("Animator") then
                    obj:Destroy()
                elseif obj:IsA("BasePart") then
                    obj.Anchored = true
                    obj.CanCollide = false
                    obj.CanTouch = false
                    obj.CanQuery = false
                    obj.Massless = true
                    obj.CastShadow = false
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Color = Color3.fromRGB(5, 5, 9)
                    obj.Transparency = 0.04
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = 1
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                    obj.Enabled = false
                end
            end
            ghost.Parent = afterFolder
            for _, obj in ipairs(ghost:GetDescendants()) do
                if obj:IsA("BasePart") then
                    obj.Anchored = true
                    obj.CanCollide = false
                    obj.CanTouch = false
                    obj.CanQuery = false
                    obj.Massless = true
                end
            end
            local startPivot = character:GetPivot()
            ghost:PivotTo(startPivot)
            local outline = Instance.new("Highlight")
            outline.Name = "RoaringWhiteInk"
            outline.Adornee = ghost
            outline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            outline.FillColor = Color3.new(0, 0, 0)
            outline.FillTransparency = 0.12
            outline.OutlineColor = Color3.new(1, 1, 1)
            outline.OutlineTransparency = 0.02
            outline.Parent = ghost
            table.insert(activeGhosts, {model=ghost, outline=outline, startPivot=startPivot, back=-direction, age=0})
        end

        playerEffectConnections.roaring = RunService.Heartbeat:Connect(function(dt)
            if not playerEffectStates.roaring or not root.Parent then return end
            elapsed += dt
            local displacement = root.Position - lastPosition
            lastPosition = root.Position
            local velocity = root.AssemblyLinearVelocity
            local moving = velocity.Magnitude > 2.5 or displacement.Magnitude > 0.035
            if moving and elapsed >= GHOST_INTERVAL then
                elapsed = 0
                local direction = velocity.Magnitude > 1 and velocity.Unit or displacement.Unit
                spawnAfterimage(direction)
            end
            for i = #activeGhosts, 1, -1 do
                local data = activeGhosts[i]
                data.age += dt
                local alpha = math.clamp(data.age / GHOST_LIFETIME, 0, 1)
                if data.model and data.model.Parent then
                    data.model:PivotTo(data.startPivot + data.back * (5.5 * data.age))
                    local fade = alpha ^ 1.15
                    for _, part in ipairs(data.model:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Transparency = 0.04 + fade * 0.96
                        end
                    end
                    if data.outline and data.outline.Parent then
                        data.outline.FillTransparency = 0.12 + fade * 0.88
                        data.outline.OutlineTransparency = 0.02 + fade * 0.98
                    end
                end
                if alpha >= 1 then
                    if data.model then data.model:Destroy() end
                    table.remove(activeGhosts, i)
                end
            end
        end)
    end
end

local function clearWorldAnime()
    if worldAnimeConnection then worldAnimeConnection:Disconnect(); worldAnimeConnection=nil end
    if worldAnimeFolder then worldAnimeFolder:Destroy(); worldAnimeFolder=nil end
    for _, obj in ipairs(worldAnimeObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(worldAnimeObjects)
    for part, original in pairs(worldAnimeOriginals) do
        if part and part.Parent then
            part.Color = original.color
            part.Material = original.material
            part.Reflectance = original.reflectance
            part:SetAttribute("DarkForgeAnimeOriginalColor", nil)
            part:SetAttribute("DarkForgeAnimeOriginalMaterial", nil)
            part:SetAttribute("DarkForgeAnimeOriginalReflectance", nil)
        end
    end
    table.clear(worldAnimeOriginals)
    local grade = Lighting:FindFirstChild("DarkForgeAnimeWorldGrade")
    if grade then grade:Destroy() end
    local bloom = Lighting:FindFirstChild("DarkForgeAnimeWorldBloom")
    if bloom then bloom:Destroy() end
end

local function setWorldAnime(enabled)
    worldAnimeEnabled = enabled
    clearWorldAnime()
    if not enabled then return end

    -- World-only comic/cel treatment. Roblox does not expose custom shader
    -- code to LocalScripts, so geometry is locally posterized and ink-outlined.
    local grade = Instance.new("ColorCorrectionEffect")
    grade.Name = "DarkForgeAnimeWorldGrade"
    grade.Saturation = -0.16
    grade.Contrast = 0.48
    grade.Brightness = 0.015
    grade.TintColor = Color3.fromRGB(255, 246, 238)
    grade.Parent = Lighting
    local bloom = Instance.new("BloomEffect")
    bloom.Name = "DarkForgeAnimeWorldBloom"
    bloom.Intensity = 0.16
    bloom.Size = 14
    bloom.Threshold = 1.35
    bloom.Parent = Lighting

    worldAnimeFolder = Instance.new("Folder")
    worldAnimeFolder.Name = "DarkForge_AnimeWorldInk"
    worldAnimeFolder.Parent = workspace
    local function stylizeColor(color)
        local lum = color.R * 0.2126 + color.G * 0.7152 + color.B * 0.0722
        local band = lum < 0.2 and 0.52 or (lum < 0.45 and 0.74 or (lum < 0.72 and 0.94 or 1.08))
        return Color3.new(
            math.clamp(math.floor(color.R * band * 4 + 0.5) / 4, 0, 1),
            math.clamp(math.floor(color.G * band * 4 + 0.5) / 4, 0, 1),
            math.clamp(math.floor(color.B * band * 4 + 0.5) / 4, 0, 1)
        )
    end
    local function scanWorld()
        if not worldAnimeEnabled or not worldAnimeFolder then return end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local count = 0
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char, worldAnimeFolder}
        params.MaxParts = 220
        for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, 260, params)) do
            if count >= 90 then break end
            if part:IsA("BasePart") and part.Transparency < 0.95 then
                local model = part:FindFirstAncestorOfClass("Model")
                local isCharacter = model and model:FindFirstChildOfClass("Humanoid") ~= nil
                if not isCharacter then
                    if not worldAnimeOriginals[part] then
                        worldAnimeOriginals[part] = {color=part.Color, material=part.Material, reflectance=part.Reflectance}
                        part:SetAttribute("DarkForgeAnimeOriginalColor", part.Color)
                        part:SetAttribute("DarkForgeAnimeOriginalMaterial", part.Material.Name)
                        part:SetAttribute("DarkForgeAnimeOriginalReflectance", part.Reflectance)
                        local celColor = stylizeColor(part.Color)
                        part.Color = celColor
                        part.Material = Enum.Material.SmoothPlastic
                        part.Reflectance = 0
                        local ink = Instance.new("Highlight")
                        ink.Name = "AnimeWorldInkContour"
                        ink.Adornee = part
                        ink.DepthMode = Enum.HighlightDepthMode.Occluded
                        ink.FillColor = celColor:Lerp(Color3.fromRGB(12, 10, 16), 0.16)
                        ink.FillTransparency = 0.68
                        ink.OutlineColor = Color3.fromRGB(20, 17, 22)
                        ink.OutlineTransparency = 0.02
                        ink.Parent = worldAnimeFolder
                        table.insert(worldAnimeObjects, ink)
                    end
                    count += 1
                end
            end
        end
    end
    scanWorld()
    local elapsed = 0
    worldAnimeConnection = RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed >= 2.5 then
            elapsed = 0
            scanWorld()
        end
    end)
end

local function setPlayerEffect(name, enabled)
    playerEffectStates[name] = enabled
    if enabled then applyPlayerEffect(name) else clearPlayerEffect(name) end
end

local function refreshPlayerEffects()
    for name, enabled in pairs(playerEffectStates) do
        if enabled then applyPlayerEffect(name) end
    end
end

