-- FLIGHT
local function loadAnim(id, loop)
    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    local a = Instance.new("Animation")
    a.AnimationId = id
    local ok, track = pcall(function() return animator:LoadAnimation(a) end)
    if ok and track then
        track.Looped = loop
        track.Priority = Enum.AnimationPriority.Action4
        return track
    end
    return nil
end
local function stopFlightAnims()
    for _, t in pairs(flightTracks) do
        if t then t:Stop(0.15) end
    end
    currentFlightAnim = nil
end
local function playFlightAnim(name)
    if currentFlightAnim == name then return end
    stopFlightAnims()
    local t = flightTracks[name]
    if t then
        t:Play(0.12)
        currentFlightAnim = name
        if name == "forward" then
            t.TimePosition = 0.8
            task.spawn(function()
                while currentFlightAnim == "forward" and t.IsPlaying do
                    if t.TimePosition >= 0.9 then t.TimePosition = 0.8 end
                    task.wait()
                end
            end)
        end
    end
end
local function enableFlight()
    flightEnabled = true
    sprinting = false
    flightBoost = false
    ensureFlightVisuals()
    showFlightNotification()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root then return end
    if hum then
        originalAutoRotate = hum.AutoRotate
        hum.AutoRotate = false
    end
    if flightBV then flightBV:Destroy() end
    if flightBG then flightBG:Destroy(); flightBG=nil end
    flightBV = Instance.new("BodyVelocity")
    flightBV.MaxForce = Vector3.new(40000, 40000, 40000)
    flightBV.Velocity = Vector3.zero
    flightBV.Parent = root
    -- High-torque gyro overrides animation/character yaw correction so the
    -- torso follows the camera pitch continuously, including straight up/down.
    flightBG = Instance.new("BodyGyro")
    flightBG.Name = "DarkForge_FlightFacing"
    flightBG.P = 90000
    flightBG.D = 1800
    flightBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flightBG.CFrame = workspace.CurrentCamera.CFrame
    flightBG.Parent = root
    flightTracks.idle    = loadAnim(FLIGHT_IDLE_ANIM, true)
