	UserInputService.InputChanged:Connect(function(inp) if isDragging and inp.UserInputType == Enum.UserInputType.MouseMovement then local d = inp.Position - dragStart; mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y) end end)
	UserInputService.InputEnded:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = false end end)

	local whLabel = Instance.new("TextLabel")
	whLabel.Text = "Wallhack (True Delete): " .. (wallhackEnabled and "ACTIVE" or "OFF")
	whLabel.Size = UDim2.new(0.9,0,0,35)
	whLabel.Position = UDim2.new(0.05,0,0,65)
	whLabel.BackgroundTransparency = 1
	whLabel.TextColor3 = Color3.new(1,1,1)
	whLabel.Font = Enum.Font.Code
	whLabel.Parent = mainFrame

	local whBtn = Instance.new("TextButton")
	whBtn.Text = wallhackEnabled and "RESTORE WORLD" or "DELETE OBSTRUCTIONS"
	whBtn.Size = UDim2.new(0.9,0,0,45)
	whBtn.Position = UDim2.new(0.05,0,0,105)
	whBtn.BackgroundColor3 = wallhackEnabled and Color3.fromRGB(200,30,30) or Color3.fromRGB(30,200,30)
	whBtn.TextColor3 = Color3.new(1,1,1)
	whBtn.Font = Enum.Font.Code
	whBtn.Parent = mainFrame
	whBtn.MouseButton1Click:Connect(function()
		wallhackEnabled = not wallhackEnabled
		applyWallhack(wallhackEnabled)
		whLabel.Text = "Wallhack (True Delete): " .. (wallhackEnabled and "ACTIVE" or "OFF")
		whBtn.Text = wallhackEnabled and "RESTORE WORLD" or "DELETE OBSTRUCTIONS"
		whBtn.BackgroundColor3 = wallhackEnabled and Color3.fromRGB(200,30,30) or Color3.fromRGB(30,200,30)
	end)

	local predLabel = Instance.new("TextLabel")
	predLabel.Text = "Prediction Strength: " .. string.format("%.2f", predictionFactor)
	predLabel.Size = UDim2.new(1,-30,0,30)
	predLabel.Position = UDim2.new(0,15,0,165)
	predLabel.BackgroundTransparency = 1
	predLabel.TextColor3 = Color3.new(1,1,1)
	predLabel.Font = Enum.Font.Code
	predLabel.Parent = mainFrame

	local track = Instance.new("Frame")
	track.Size = UDim2.new(0.9,0,0,14)
	track.Position = UDim2.new(0.05,0,0,200)
	track.BackgroundColor3 = Color3.fromRGB(30,30,50)
	track.Parent = mainFrame

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(predictionFactor / 0.22,0,1,0)
	fill.BackgroundColor3 = Color3.fromRGB(0,240,160)
	fill.Parent = track

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0,20,0,20)
	knob.Position = UDim2.new(predictionFactor / 0.22,-10,-0.25,0)
	knob.BackgroundColor3 = Color3.fromRGB(0,255,200)
	knob.Parent = track

	local function updatePrediction(xPos)
		local rel = math.clamp((xPos - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		predictionFactor = rel * 0.22
		fill.Size = UDim2.new(rel,0,1,0)
		knob.Position = UDim2.new(rel,-10,-0.25,0)
		predLabel.Text = "Prediction Strength: " .. string.format("%.2f", predictionFactor)
	end

	track.InputBegan:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 then isSliderDragging = true; updatePrediction(inp.Position.X) end end)
	UserInputService.InputChanged:Connect(function(inp) if isSliderDragging and inp.UserInputType == Enum.UserInputType.MouseMovement then updatePrediction(inp.Position.X) end end)
	UserInputService.InputEnded:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 then isSliderDragging = false end end)

	local function createRebindBtn(txt, ypos, mode)
