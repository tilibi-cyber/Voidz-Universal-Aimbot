	status.Size = UDim2.new(1,-20,0,40)
	status.Position = UDim2.new(0,10,1,-55)
	status.BackgroundTransparency = 1
	status.TextColor3 = Color3.fromRGB(80,255,140)
	status.Font = Enum.Font.Code
	status.Parent = mainFrame
