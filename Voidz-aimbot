-- DarkForge-X SHADOW-CORE v3.3 | ORIGINAL CAMERA AIMBOT + ORIGINAL SPINBOT

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local aimlockEnabled = false
local spinbotEnabled = false
local wallhackEnabled = false
local teamCheckEnabled = true
local predictionFactor = 0.09
local aimPart = "Head"
local spinSpeed = 55

local lockedTarget = nil
local holdKey = Enum.KeyCode.ButtonL2
local spinbotKey = Enum.KeyCode.R
local teamSwitchKey = Enum.KeyCode.L
local settingsKey = Enum.KeyCode.Minus

local velocityCache = {}
local settingsGui = nil
local isDragging = false
local dragStart, startPos = nil, nil
local isSliderDragging = false
local rebindingFor = nil

local hiddenFolder = nil
local storedParts = {}

local function getScreenDistance(part)
	if not part then return math.huge end
	local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
	if not onScreen then return math.huge end
	local mousePos = UserInputService:GetMouseLocation()
	return (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
end

local function findTargetNearCursor()
	local bestPart, bestDist = nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
			local targetPart = plr.Character:FindFirstChild(aimPart) or plr.Character:FindFirstChild("HumanoidRootPart")
			if targetPart then
				local shouldTarget = not (teamCheckEnabled and LocalPlayer.Team and plr.Team and LocalPlayer.Team == plr.Team)
				if shouldTarget then
					local dist = getScreenDistance(targetPart)
					if dist < bestDist and dist < 350 then
						bestDist = dist
						bestPart = targetPart
						lockedTarget = plr
					end
				end
			end
		end
	end
	return bestPart
end

local function isTargetValid()
	if not lockedTarget or not lockedTarget.Character then return false end
	local hum = lockedTarget.Character:FindFirstChild("Humanoid")
	return hum and hum.Health > 0
end

local function predictPosition(targetPart)
	if not targetPart then return targetPart.Position end
	local vel = targetPart.Velocity
	if not velocityCache[targetPart] then velocityCache[targetPart] = vel end
	velocityCache[targetPart] = velocityCache[targetPart]:Lerp(vel, 0.4)
	return targetPart.Position + (velocityCache[targetPart] * predictionFactor)
end

-- ===================== MAIN LOOP =====================
RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChild("Humanoid")

	-- ORIGINAL SPINBOT
	if spinbotEnabled and root and hum then
		local currentYaw = tick() * spinSpeed
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(-89), math.rad(currentYaw % 360), 0)
		hum.AutoRotate = false
	elseif hum then
		hum.AutoRotate = true
	end

	-- ORIGINAL CAMERA AIMBOT (restored)
	if not aimlockEnabled then
		lockedTarget = nil
		return
	end
	if not isTargetValid() then lockedTarget = nil end

	local targetPart = lockedTarget and (lockedTarget.Character and (lockedTarget.Character:FindFirstChild(aimPart) or lockedTarget.Character:FindFirstChild("HumanoidRootPart")))
		or (not lockedTarget and findTargetNearCursor())

	if targetPart then
		local predicted = predictPosition(targetPart)
		Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, predicted)
	end
end)

-- ===================== WALLHACK =====================
local wallhackConnection = nil
local function applyWallhack(enabled)
	if enabled then
		if not hiddenFolder then
			hiddenFolder = Instance.new("Folder")
			hiddenFolder.Name = "DarkForge_Hidden"
			hiddenFolder.Parent = game:GetService("CoreGui")
		end
		storedParts = {}
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("BasePart") and not obj.Parent:FindFirstChildWhichIsA("Humanoid") and obj ~= workspace.Terrain then
				local playerPos = LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and LocalPlayer.Character.PrimaryPart.Position
				local isRelevant = playerPos and ((obj.Position.Y <= playerPos.Y + 8) or (obj.Position - playerPos).Magnitude < 25)
				if not isRelevant then
					storedParts[obj] = obj.Parent
					obj.Parent = hiddenFolder
				end
			end
		end
		wallhackConnection = RunService.Heartbeat:Connect(function()
			if not wallhackEnabled then return end
			local playerPos = LocalPlayer.Character and LocalPlayer.Character.PrimaryPart and LocalPlayer.Character.PrimaryPart.Position
			if not playerPos then return end
			for obj, originalParent in pairs(storedParts) do
				if obj and obj.Parent == hiddenFolder then
					local isRelevant = (obj.Position.Y <= playerPos.Y + 10) or (obj.Position - playerPos).Magnitude < 30
					if isRelevant then obj.Parent = originalParent end
				elseif obj and obj.Parent ~= hiddenFolder then
					local isRelevant = (obj.Position.Y <= playerPos.Y + 10) or (obj.Position - playerPos).Magnitude < 30
					if not isRelevant then
						storedParts[obj] = obj.Parent
						obj.Parent = hiddenFolder
					end
				end
			end
		end)
	else
		if wallhackConnection then wallhackConnection:Disconnect() wallhackConnection = nil end
		for obj, originalParent in pairs(storedParts) do
			if obj and originalParent and originalParent.Parent then obj.Parent = originalParent end
		end
		storedParts = {}
		if hiddenFolder then hiddenFolder:Destroy() hiddenFolder = nil end
	end
end

-- ===================== INPUT =====================
UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end

	if rebindingFor then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			if rebindingFor == "hold" then holdKey = input.KeyCode
			elseif rebindingFor == "spin" then spinbotKey = input.KeyCode
			elseif rebindingFor == "team" then teamSwitchKey = input.KeyCode end
			print("DarkForge-X | Rebound successful.")
			rebindingFor = nil
		end
		return
	end

	if input.KeyCode == holdKey then
		aimlockEnabled = true
		print("DarkForge-X | CAMERA AIMBOT: ENGAGED")
	elseif input.KeyCode == spinbotKey then
		spinbotEnabled = not spinbotEnabled
		print("DarkForge-X | SPINBOT: " .. (spinbotEnabled and "ON" or "OFF"))
	elseif input.KeyCode == teamSwitchKey then
		teamCheckEnabled = not teamCheckEnabled
		print("DarkForge-X | MODE: " .. (teamCheckEnabled and "TEAM CHECK" or "FFA"))
	elseif input.KeyCode == settingsKey then
		if settingsGui and settingsGui.Parent then
			local main = settingsGui:FindFirstChild("Main")
			if main then TweenService:Create(main, TweenInfo.new(0.28, Enum.EasingStyle.Quint), {BackgroundTransparency = main.BackgroundTransparency == 0 and 1 or 0}):Play() end
			settingsGui.Enabled = not settingsGui.Enabled
		else
			createSettingsUI()
		end
	end
end)

UserInputService.InputEnded:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == holdKey then
		aimlockEnabled = false
		lockedTarget = nil
		print("DarkForge-X | CAMERA AIMBOT: RELEASED")
	end
end)

